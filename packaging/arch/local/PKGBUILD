# Maintainer: William C. Canin
pkgname=argvus-taskbar-calendar
pkgver=0.2.0
pkgrel=1
pkgdesc="Calendar popup for Waybar, written in Rust for the Argvus desktop"
arch=('x86_64')
url="https://github.com/argvus/argvus-taskbar-calendar"
license=('GPL-3.0-only')
options=('!debug' '!lto')
depends=(
  'gtk4'
  'gtk4-layer-shell'
  'jq'
  'xdg-utils'
)
makedepends=(
  'cargo'
  'pkgconf'
)
backup=(
  'etc/argvus/taskbar/calendar/config.toml'
  'etc/argvus/taskbar/calendar/style.css'
  'etc/argvus/taskbar/calendar/theme.css'
  'etc/argvus/taskbar/calendar/themes/argvus-dark.css'
  'etc/argvus/taskbar/calendar/themes/argvus-dark-float.css'
  'etc/argvus/taskbar/calendar/themes/dracula.css'
  'etc/argvus/taskbar/calendar/themes/dracula-float.css'
  'etc/argvus/taskbar/calendar/themes/gruvbox-dark.css'
  'etc/argvus/taskbar/calendar/themes/gruvbox-dark-float.css'
  'etc/argvus/taskbar/calendar/themes/gruvbox-high-dark.css'
  'etc/argvus/taskbar/calendar/themes/gruvbox-high-dark-float.css'
  'etc/argvus/taskbar/calendar/themes/hackerman.css'
  'etc/argvus/taskbar/calendar/themes/hackerman-float.css'
  'etc/argvus/taskbar/calendar/themes/monokai-dark.css'
  'etc/argvus/taskbar/calendar/themes/monokai-dark-float.css'
  'etc/argvus/taskbar/calendar/themes/rose-pine.css'
  'etc/argvus/taskbar/calendar/themes/rose-pine-float.css'
  'etc/argvus/taskbar/calendar/themes/silver-dark.css'
  'etc/argvus/taskbar/calendar/themes/silver-dark-float.css'
  'etc/argvus/taskbar/calendar/themes/slate-dark.css'
  'etc/argvus/taskbar/calendar/themes/slate-dark-float.css'
  'etc/argvus/taskbar/calendar/themes/solitude.css'
  'etc/argvus/taskbar/calendar/themes/solitude-float.css'
  'etc/argvus/taskbar/calendar/themes/sunset.css'
  'etc/argvus/taskbar/calendar/themes/sunset-float.css'
  'etc/argvus/taskbar/calendar/themes/tokyo-night.css'
  'etc/argvus/taskbar/calendar/themes/universe.css'
  'etc/argvus/taskbar/calendar/themes/universe-float.css'
  'etc/argvus/taskbar/calendar/themes/github-light.css'
  'etc/argvus/taskbar/calendar/themes/github-light-float.css'
  'etc/argvus/taskbar/calendar/themes/catppuccin-latte.css'
  'etc/argvus/taskbar/calendar/themes/catppuccin-latte-float.css'
  'etc/argvus/taskbar/calendar/themes/argvus-light.css'
  'etc/argvus/taskbar/calendar/themes/argvus-light-float.css'
  'etc/argvus/taskbar/calendar/themes/frost.css'
  'etc/argvus/taskbar/calendar/themes/frost-float.css'
  'etc/argvus/taskbar/calendar/themes/solarized-light.css'
  'etc/argvus/taskbar/calendar/themes/solarized-light-float.css'
  'etc/argvus/taskbar/calendar/themes/one-light.css'
  'etc/argvus/taskbar/calendar/themes/one-light-float.css'
  'etc/argvus/taskbar/calendar/themes/one-dark.css'
  'etc/argvus/taskbar/calendar/themes/one-dark-float.css'
)
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=("SKIP")

_cargo_target_dir() {
  printf '%s' "${CARGO_TARGET_DIR:-$srcdir/${pkgname}-${pkgver}/target}"
}

prepare() {
  cd "${pkgname}-${pkgver}"
  cargo fetch --locked --target "${CARCH}-unknown-linux-gnu"
}

build() {
  cd "${pkgname}-${pkgver}"

  export CFLAGS="${CFLAGS/-flto=auto/}"
  export CXXFLAGS="${CXXFLAGS/-flto=auto/}"
  export FFLAGS="${FFLAGS/-flto=auto/}"
  export FCFLAGS="${FCFLAGS/-flto=auto/}"
  export LDFLAGS="${LDFLAGS/-flto=auto/}"

  cargo build --workspace --release --locked
}

check() {
  cd "${pkgname}-${pkgver}"

  export CFLAGS="${CFLAGS/-flto=auto/}"
  export CXXFLAGS="${CXXFLAGS/-flto=auto/}"
  export FFLAGS="${FFLAGS/-flto=auto/}"
  export FCFLAGS="${FCFLAGS/-flto=auto/}"
  export LDFLAGS="${LDFLAGS/-flto=auto/}"

  cargo test --workspace --locked
}

package() {
  cd "${pkgname}-${pkgver}"

  ETCDIR="etc/argvus/taskbar/calendar"

  install -Dm755 "$(_cargo_target_dir)/release/${pkgname}" \
    "${pkgdir}/usr/bin/${pkgname}"

  install -Dm755 resources/argvus-taskbar-calendar-waybar \
    "${pkgdir}/usr/lib/${pkgname}/waybar-launcher"

  install -Dm644 resources/config.toml \
    "${pkgdir}/${ETCDIR}/config.toml"
  install -Dm644 resources/style.css \
    "${pkgdir}/${ETCDIR}/style.css"
  install -Dm644 resources/theme.css \
    "${pkgdir}/${ETCDIR}/theme.css"

  install -dm755 "${pkgdir}/${ETCDIR}/themes"
  install -m644 resources/themes/*.css "${pkgdir}/${ETCDIR}/themes/"

  install -Dm644 docs/systemd/argvus-taskbar-calendar.service \
    "${pkgdir}/usr/lib/systemd/user/${pkgname}.service"

  install -Dm644 LICENSE \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
