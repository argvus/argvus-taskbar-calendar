# Maintainer: William C. Canin
pkgname=argvus-taskbar-calendar
pkgver=0.2.0
pkgrel=1
pkgdesc="Calendar popup for Waybar, written in Rust for the Argvus desktop"
arch=('x86_64')
url="https://github.com/argvus/argvus-taskbar-calendar"
license=('GPL-3.0-only')
options=('!debug' '!lto')
depends=(
  'gtk4'
  'gtk4-layer-shell'
  'jq'
  'xdg-utils'
)
makedepends=(
  'cargo'
  'pkgconf'
)
backup=(
  'etc/argvus/taskbar/calendar/config.toml'
  'etc/argvus/taskbar/calendar/style.css'
  'etc/argvus/taskbar/calendar/theme.css'
  'etc/argvus/taskbar/calendar/themes/argvus-dark-aether.css'
  'etc/argvus/taskbar/calendar/themes/argvus-dark-aether-float.css'
  'etc/argvus/taskbar/calendar/themes/argvus-dark-dracula.css'
  'etc/argvus/taskbar/calendar/themes/argvus-dark-dracula-float.css'
  'etc/argvus/taskbar/calendar/themes/argvus-dark-gruvbox.css'
  'etc/argvus/taskbar/calendar/themes/argvus-dark-gruvbox-float.css'
  'etc/argvus/taskbar/calendar/themes/argvus-dark-gruvbox-high.css'
  'etc/argvus/taskbar/calendar/themes/argvus-dark-gruvbox-high-float.css'
  'etc/argvus/taskbar/calendar/themes/argvus-dark-hackerman.css'
  'etc/argvus/taskbar/calendar/themes/argvus-dark-hackerman-float.css'
  'etc/argvus/taskbar/calendar/themes/argvus-dark-rosepine.css'
  'etc/argvus/taskbar/calendar/themes/argvus-dark-rosepine-float.css'
  'etc/argvus/taskbar/calendar/themes/argvus-dark-silver.css'
  'etc/argvus/taskbar/calendar/themes/argvus-dark-silver-float.css'
  'etc/argvus/taskbar/calendar/themes/argvus-dark-slate.css'
  'etc/argvus/taskbar/calendar/themes/argvus-dark-slate-float.css'
  'etc/argvus/taskbar/calendar/themes/argvus-dark-solitude.css'
  'etc/argvus/taskbar/calendar/themes/argvus-dark-solitude-float.css'
  'etc/argvus/taskbar/calendar/themes/argvus-dark-sunset.css'
  'etc/argvus/taskbar/calendar/themes/argvus-dark-sunset-float.css'
  'etc/argvus/taskbar/calendar/themes/argvus-dark-tokio-night.css'
  'etc/argvus/taskbar/calendar/themes/argvus-dark-universe.css'
  'etc/argvus/taskbar/calendar/themes/argvus-dark-universe-float.css'
  'etc/argvus/taskbar/calendar/themes/argvus-github-light.css'
  'etc/argvus/taskbar/calendar/themes/argvus-github-light-float.css'
  'etc/argvus/taskbar/calendar/themes/argvus-light-catppuccin-latte.css'
  'etc/argvus/taskbar/calendar/themes/argvus-light-catppuccin-latte-float.css'
  'etc/argvus/taskbar/calendar/themes/argvus-light-veil.css'
  'etc/argvus/taskbar/calendar/themes/argvus-light-veil-float.css'
  'etc/argvus/taskbar/calendar/themes/argvus-light-frost.css'
  'etc/argvus/taskbar/calendar/themes/argvus-light-frost-float.css'
  'etc/argvus/taskbar/calendar/themes/argvus-light-solarized.css'
  'etc/argvus/taskbar/calendar/themes/argvus-light-solarized-float.css'
  'etc/argvus/taskbar/calendar/themes/argvus-onedark.css'
  'etc/argvus/taskbar/calendar/themes/argvus-onedark-float.css'
